<section class="orders py-16">
  <div class="container mx-auto xl:w-1/2">
    <div class="flex items-center border-b border-gray-300 pb-4">
      <img src="/img/cart-black.png" alt="" />
      <h1 class="font-bold ml-4 text-2xl">Your Orders</h1>
    </div>

    <% if(orders && orders.length > 0) { %>
    <div class="mt-8">
      <% orders.forEach(order => { %>
      <div class="bg-white shadow-md rounded-lg p-6 mb-4">
        <div class="flex justify-between items-start mb-4">
          <div>
            <h3 class="text-lg font-semibold">
              Order #<%= order._id.toString().slice(-6) %>
            </h3>
            <p class="text-gray-600">
              Placed on <%= new Date(order.createdAt).toLocaleDateString() %>
            </p>
          </div>
          <div class="text-right">
            <span class="text-2xl font-bold">₹<%= order.totalPrice %></span>
            <div class="mt-2">
              <span
                class="px-3 py-1 rounded-full text-xs font-semibold <%= order.status === 'delivered' ? 'bg-green-100 text-green-800' : order.status === 'cancelled' ? 'bg-red-100 text-red-800' : 'bg-yellow-100 text-yellow-800' %>"
              >
                <%= order.status.replace('_', ' ').toUpperCase() %>
              </span>
            </div>
          </div>
        </div>

        <div class="border-t pt-4">
          <h4 class="font-semibold mb-2">Items:</h4>
          <% order.items.forEach(item => { %>
          <div class="flex justify-between items-center py-2">
            <div class="flex items-center">
              <img
                class="w-12 h-12 object-cover rounded mr-3"
                src="/img/<%= item.item.image %>"
                alt="<%= item.item.name %>"
              />
              <div>
                <p class="font-medium"><%= item.item.name %></p>
                <p class="text-sm text-gray-600"><%= item.item.size %></p>
              </div>
            </div>
            <div class="text-right">
              <p class="font-medium">Qty: <%= item.qty %></p>
              <p class="text-sm text-gray-600">
                ₹<%= item.item.price * item.qty %>
              </p>
            </div>
          </div>
          <% }) %>
        </div>
      </div>
      <% }) %>
    </div>
    <% } else { %>
    <div class="text-center py-16">
      <h2 class="text-2xl font-bold mb-4">No orders yet</h2>
      <p class="text-gray-600 mb-8">
        You haven't placed any orders yet. Start shopping!
      </p>
      <a
        href="/"
        class="btn-primary px-6 py-2 rounded-full text-white font-bold"
      >
        Start Shopping
      </a>
    </div>
    <% } %>
  </div>
</section>
