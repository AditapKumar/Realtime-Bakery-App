<section class="admin-single-order py-16">
    <div class="container mx-auto xl:w-1/2">
        <div class="flex items-center justify-between border-b border-gray-300 pb-4 mb-8">
            <div class="flex items-center">
                <img src="/img/cart-black.png" alt="">
                <h1 class="font-bold ml-4 text-2xl">Admin - Order Details</h1>
            </div>
            <a href="/admin/orders" class="text-blue-600 hover:text-blue-800 font-medium">
                ← Back to All Orders
            </a>
        </div>
        
        <div class="bg-white shadow-md rounded-lg p-6">
            <div class="flex justify-between items-start mb-6">
                <div>
                    <h2 class="text-2xl font-bold">Order #<%= order._id.toString().slice(-6) %></h2>
                    <p class="text-gray-600">Placed on <%= new Date(order.createdAt).toLocaleDateString() %></p>
                </div>
                <div class="text-right">
                    <span class="text-3xl font-bold">₹<%= order.totalPrice %></span>
                    <div class="mt-2">
                        <select class="status-select px-4 py-2 rounded-full text-sm font-semibold border" 
                                data-order-id="<%= order._id %>" 
                                data-current-status="<%= order.status %>">
                            <option value="order_placed" <%= order.status === 'order_placed' ? 'selected' : '' %>>ORDER PLACED</option>
                            <option value="confirmed" <%= order.status === 'confirmed' ? 'selected' : '' %>>CONFIRMED</option>
                            <option value="preparing" <%= order.status === 'preparing' ? 'selected' : '' %>>PREPARING</option>
                            <option value="out_for_delivery" <%= order.status === 'out_for_delivery' ? 'selected' : '' %>>OUT FOR DELIVERY</option>
                            <option value="delivered" <%= order.status === 'delivered' ? 'selected' : '' %>>DELIVERED</option>
                            <option value="cancelled" <%= order.status === 'cancelled' ? 'selected' : '' %>>CANCELLED</option>
                        </select>
                    </div>
                </div>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                <div>
                    <h3 class="font-semibold mb-2">Customer Information</h3>
                    <p><strong>Name:</strong> <%= order.customerId.name %></p>
                    <p><strong>Email:</strong> <%= order.customerId.email %></p>
                    <p><strong>Phone:</strong> <%= order.phone %></p>
                </div>
                <div>
                    <h3 class="font-semibold mb-2">Delivery Information</h3>
                    <p><strong>Address:</strong> <%= order.address %></p>
                    <p><strong>Order Phone:</strong> <%= order.phone %></p>
                </div>
            </div>
            
            <div class="border-t pt-6">
                <h3 class="font-semibold mb-4">Order Items</h3>
                <% order.items.forEach(item => { %>
                    <div class="flex items-center py-4 border-b border-gray-200 last:border-b-0">
                        <img class="w-16 h-16 object-cover rounded mr-4" src="/img/<%= item.item.image %>" alt="<%= item.item.name %>">
                        <div class="flex-1">
                            <h4 class="font-medium text-lg"><%= item.item.name %></h4>
                            <p class="text-gray-600"><%= item.item.size %></p>
                        </div>
                        <div class="text-right">
                            <p class="font-medium">Quantity: <%= item.qty %></p>
                            <p class="text-lg font-bold">₹<%= item.item.price * item.qty %></p>
                            <p class="text-sm text-gray-600">₹<%= item.item.price %> each</p>
                        </div>
                    </div>
                <% }) %>
            </div>
            
            <div class="mt-6 pt-6 border-t">
                <div class="flex justify-between items-center">
                    <div class="text-sm text-gray-600">
                        <p>Order ID: <%= order._id %></p>
                        <p>Created: <%= new Date(order.createdAt).toLocaleString() %></p>
                        <% if(order.updatedAt && order.updatedAt.getTime() !== order.createdAt.getTime()) { %>
                            <p>Updated: <%= new Date(order.updatedAt).toLocaleString() %></p>
                        <% } %>
                    </div>
                    <div class="text-right">
                        <p class="text-sm text-gray-600">Total Amount</p>
                        <p class="text-2xl font-bold">₹<%= order.totalPrice %></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
// Handle status updates
document.querySelector('.status-select').addEventListener('change', async (e) => {
    const orderId = e.target.dataset.orderId;
    const status = e.target.value;
    
    try {
        const response = await fetch('/admin/orders/status', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({ orderId, status })
        });
        
        if (response.ok) {
            // Show success notification
            const noty = new Noty({
                type: 'success',
                timeout: 2000,
                text: 'Order status updated successfully',
                progressBar: false,
            });
            noty.show();
        } else {
            throw new Error('Failed to update status');
        }
    } catch (error) {
        // Revert selection on error
        e.target.value = e.target.dataset.currentStatus;
        
        const noty = new Noty({
            type: 'error',
            timeout: 2000,
            text: 'Failed to update order status',
            progressBar: false,
        });
        noty.show();
    }
});
</script>
